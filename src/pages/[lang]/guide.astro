---
import { getI18n, supportedLocales } from '../../data/i18n';
import type { SupportedLocale } from '../../data/types';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import TravelTipsSection from '../../components/TravelTipsSection.astro';
import DressCodeSection from '../../components/DressCodeSection.astro';
import Footer from '../../components/Footer.astro';
import ScrollAnimations from '../../components/ScrollAnimations.astro';

export function getStaticPaths() {
  return supportedLocales.map((loc) => ({ params: { lang: loc.code } }));
}

const currentLocale = Astro.params.lang as SupportedLocale;
const content = getI18n(currentLocale);
---

<Base lang={currentLocale} title={`${content.guide.title} | ${content.meta.title}`} description={content.guide.subtitle}>
  <Header locale={currentLocale} nav={content.nav} path="guide/" solid />

  <main class="pt-24">
    <!-- Each section brings its own heading; the page only adds a way back. -->
    <div class="relative z-10 px-4 pt-10 sm:px-6 lg:px-8">
      <a
        href={`/${currentLocale}/`}
        class="mx-auto flex w-fit items-center gap-2 font-sans text-xs tracking-[0.25em] text-accent-700 uppercase transition-colors hover:text-accent-900"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
        {content.guide.back}
      </a>
    </div>

    <TravelTipsSection content={content.travelTips} />
    <DressCodeSection content={content.dressCode} />
  </main>

  <Footer content={content.footer} />
  <ScrollAnimations />
</Base>

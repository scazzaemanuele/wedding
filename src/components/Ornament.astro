---
interface Props {
  class?: string;
  light?: boolean;
}

const { class: className = '', light = false, ...rest } = Astro.props;
---

<div class={`flex items-center justify-center gap-3 ${light ? 'text-white' : 'text-accent-600'} ${className}`} aria-hidden="true" {...rest}>
  <span class="h-px w-10 bg-current/60 sm:w-16"></span>
  <svg viewBox="0 0 8 8" class="h-2 w-2 rotate-45 fill-current">
    <rect width="8" height="8"></rect>
  </svg>
  <span class="h-px w-10 bg-current/60 sm:w-16"></span>
</div>

---
interface Props {
  class?: string;
}

const { class: className = '', ...rest } = Astro.props;
---

<div class={`flex items-center justify-center gap-3 ${className}`} aria-hidden="true" {...rest}>
  <span class="h-px w-10 bg-accent-600/60 sm:w-16"></span>
  <svg viewBox="0 0 8 8" class="h-2 w-2 rotate-45 fill-accent-600">
    <rect width="8" height="8"></rect>
  </svg>
  <span class="h-px w-10 bg-accent-600/60 sm:w-16"></span>
</div>

---
import type { I18nContent } from '../data/types';
import { Image } from 'astro:assets';
import lavenderSingle from '../assets/lavender-single.png';
import lavenderCluster from '../assets/lavender-cluster.png';

interface Props {
  content: I18nContent['invitation'];
}

const { content } = Astro.props;
---

<section id="invitation" class="section relative overflow-x-clip bg-gradient-to-b from-white via-accent-50 to-white">
  {/* Soft lavender wash behind the card */}
  <div class="pointer-events-none absolute left-1/2 top-1/2 h-[28rem] w-[min(60rem,120vw)] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent-200/40 blur-3xl" aria-hidden="true" />

  {/* Lavender outside the card, bleeding off the edges */}
  <Image src={lavenderCluster} alt="" width={420} aria-hidden="true" class="lavender-sway pointer-events-none absolute top-10 -left-4 z-0 w-40 opacity-90 [animation-delay:-3s] sm:top-6 sm:left-4 sm:w-52 md:left-[8%] md:w-64 lg:left-[11%] lg:w-80 [mask-image:linear-gradient(to_bottom,transparent,black_20%)]" />

  <div class="relative z-10 max-w-3xl mx-auto pt-24 sm:pt-32">
    {/* Lavender sprig peeking over the card's top edge, behind it */}
    <Image src={lavenderSingle} alt="" width={200} aria-hidden="true" class="lavender-sway pointer-events-none absolute inset-x-0 top-12 z-0 mx-auto h-44 w-auto sm:top-8 sm:h-60" />

    {/* Parchment Invitation Card */}
    <div data-reveal class="relative z-10 p-8 sm:p-12 md:p-16 rounded-3xl bg-white/95 border border-accent-200 shadow-2xl shadow-accent-600/15 text-center">
      {/* Decorative Ornate Borders */}
      <div class="absolute inset-3 sm:inset-4 border border-accent-200 pointer-events-none rounded-2xl" />
      <div class="absolute inset-5 sm:inset-6 border border-accent-100 pointer-events-none rounded-xl" />

      {/* Eyebrow */}
      <span class="inline-block mb-3 font-sans text-xs font-semibold tracking-[0.25em] text-accent-700 uppercase">
        {content.eyebrow}
      </span>

      {/* Title */}
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-ink-950 mb-6">
        {content.title}
      </h2>

      {/* Salutation */}
      <p class="font-serif italic text-lg sm:text-xl text-ink-900 mb-6 font-semibold">
        {content.greeting}
      </p>

      {/* Letter Body Paragraphs */}
      <div class="space-y-4 font-serif text-stone-700 text-sm sm:text-base md:text-lg leading-relaxed text-justify sm:text-center max-w-2xl mx-auto">
        <p>{content.letterParagraph1}</p>
        <p>{content.letterParagraph2}</p>
        <p>{content.letterParagraph3}</p>
      </div>

      {/* Couple Signature */}
      <div class="mt-8 pt-6 border-t border-accent-200/80">
        <p class="font-script text-3xl sm:text-4xl text-ink-900 whitespace-pre-line">
          {content.signature}
        </p>
      </div>

      {/* Response Notice */}
      <!-- <div class="mt-6 inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-accent-50 border border-accent-300 text-xs font-medium text-ink-900">
        <span>🕊️</span>
        <span>{content.ceremonyNotice}</span>
      </div> -->
    </div>
  </div>
</section>

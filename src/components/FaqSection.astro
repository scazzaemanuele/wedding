---
import type { I18nContent } from '../data/types';
import { FaqAccordion } from './react/FaqAccordion';

interface Props {
  content: I18nContent['faq'];
}

const { content } = Astro.props;
---

<section id="faq" class="py-24 px-4 sm:px-6 lg:px-8 relative z-10 bg-gold-50/40">
  <div class="max-w-4xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16 gsap-reveal">
      <span class="text-xs font-sans font-bold uppercase tracking-widest text-gold-700 mb-2 block">
        {content.eyebrow}
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-emerald-950">
        {content.title}
      </h2>
      <p class="text-stone-600 mt-2 font-serif text-sm sm:text-base">
        {content.subtitle}
      </p>
      <div class="w-16 h-0.5 bg-gold-400 mx-auto mt-4" />
    </div>

    <div class="gsap-reveal">
      <FaqAccordion content={content} client:visible />
    </div>
  </div>
</section>

---
import type { I18nContent } from '../data/types';
import { GuestbookBoard } from './react/GuestbookBoard';
import SectionHeader from './SectionHeader.astro';

interface Props {
  content: I18nContent['wishes'];
}

const { content } = Astro.props;
---

<section id="wishes" class="section section-tint">
  <div class="max-w-6xl mx-auto">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} subtitle={content.subtitle} />

    <div data-reveal>
      <GuestbookBoard content={content} client:visible />
    </div>
  </div>
</section>

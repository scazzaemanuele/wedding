---
import type { I18nContent } from '../data/types';
import SectionHeader from './SectionHeader.astro';
import Ornament from './Ornament.astro';

interface Props {
  content: I18nContent['travelTips'];
}

const { content } = Astro.props;

const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<section id="travel" class="section">
  <div class="mx-auto max-w-6xl">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} subtitle={content.subtitle} />

    <ol class="mx-auto max-w-2xl divide-y divide-accent-200 border-y border-accent-200">
      {content.tips.map((tip, i) => (
        <li data-reveal class="grid grid-cols-[3rem_1fr] gap-x-5 py-8 sm:grid-cols-[4rem_1fr] sm:gap-x-8 sm:py-10">
          <span class="font-serif text-4xl leading-none text-accent-500 italic sm:text-5xl">{pad(i)}</span>
          <div>
            <h3 class="font-serif text-xl font-bold text-ink-950 sm:text-2xl">{tip.title}</h3>
            <p class="mt-2 font-serif text-base leading-relaxed text-stone-600">{tip.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <div data-reveal class="mx-auto mt-16 max-w-xl text-center">
      <Ornament />
      <p class="mt-6 font-script text-3xl leading-snug text-accent-700 sm:text-4xl">{content.closing}</p>
    </div>
  </div>
</section>


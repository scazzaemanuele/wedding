---
import type { I18nContent } from '../data/types';
import { WEDDING_CONFIG } from '../data/wedding-data';
import SectionHeader from './SectionHeader.astro';

interface Props {
  content: I18nContent['venue'];
}

const { content } = Astro.props;
---

<section id="venue" class="section">
  <div class="max-w-6xl mx-auto">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} subtitle={content.subtitle} />

    {/* About the resort (name, address and map live in the Venue & Schedule section) */}
    <div data-reveal class="mx-auto mb-16 max-w-3xl rounded-3xl border border-gold-200 bg-white p-6 shadow-lg sm:p-10">
      <h3 class="font-serif text-2xl font-bold text-emerald-950 sm:text-3xl">{content.aboutTitle}</h3>
      <p class="mt-3 font-serif text-sm leading-relaxed text-stone-700 sm:text-base">{content.aboutDesc}</p>

      <h4 class="mt-6 mb-3 font-sans text-xs font-semibold tracking-[0.25em] text-gold-700 uppercase">
        {content.villaHighlightsTitle}
      </h4>
      <ul class="grid gap-2 sm:grid-cols-2">
        {content.highlights.map((item) => (
          <li class="flex items-start gap-2 font-serif text-sm text-stone-700">
            <span class="font-bold text-gold-600">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    {/* 4 Travel Advice Cards */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {/* Flight Card */}
      <div data-reveal class="p-6 rounded-2xl bg-white/90 backdrop-blur-md border border-gold-200 shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
        <span class="text-3xl mb-3 block">✈️</span>
        <h4 class="font-serif font-bold text-lg text-emerald-950 mb-2">
          {content.travelCards.flightTitle}
        </h4>
        <p class="font-serif text-xs sm:text-sm text-stone-600 leading-relaxed">
          {content.travelCards.flightDesc}
        </p>
      </div>

      {/* Transfer Card */}
      <div data-reveal class="p-6 rounded-2xl bg-white/90 backdrop-blur-md border border-gold-200 shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
        <span class="text-3xl mb-3 block">🚐</span>
        <h4 class="font-serif font-bold text-lg text-emerald-950 mb-2">
          {content.travelCards.transferTitle}
        </h4>
        <p class="font-serif text-xs sm:text-sm text-stone-600 leading-relaxed">
          {content.travelCards.transferDesc}
        </p>
      </div>

      {/* Visa Card */}
      <div data-reveal class="p-6 rounded-2xl bg-white/90 backdrop-blur-md border border-gold-200 shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
        <span class="text-3xl mb-3 block">🛂</span>
        <h4 class="font-serif font-bold text-lg text-emerald-950 mb-2">
          {content.travelCards.visaTitle}
        </h4>
        <p class="font-serif text-xs sm:text-sm text-stone-600 leading-relaxed">
          {content.travelCards.visaDesc}
        </p>
      </div>

      {/* Weather Card */}
      <div data-reveal class="p-6 rounded-2xl bg-white/90 backdrop-blur-md border border-gold-200 shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
        <span class="text-3xl mb-3 block">☀️</span>
        <h4 class="font-serif font-bold text-lg text-emerald-950 mb-2">
          {content.travelCards.weatherTitle}
        </h4>
        <p class="font-serif text-xs sm:text-sm text-stone-600 leading-relaxed">
          {content.travelCards.weatherDesc}
        </p>
      </div>
    </div>

    {/* Partner Resort Accommodation Card */}
    <div data-reveal class="p-8 sm:p-10 rounded-3xl bg-gradient-to-r from-emerald-950 via-emerald-900 to-emerald-950 text-gold-100 border border-gold-400/40 shadow-2xl">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="max-w-2xl text-center lg:text-left">
          <span class="inline-block px-3 py-1 rounded-full bg-gold-400/20 text-gold-300 text-xs font-bold uppercase tracking-widest mb-3">
            {content.hotelBooking.discountText}
          </span>
          <h3 class="text-2xl sm:text-3xl font-serif font-bold text-white mb-2">
            {content.hotelBooking.title}
          </h3>
          <p class="text-gold-200/90 text-sm sm:text-base font-serif leading-relaxed">
            {content.hotelBooking.desc}
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-4 shrink-0">
          <div class="px-5 py-3 rounded-2xl bg-black/40 border border-gold-400/60 text-center">
            <span class="text-[10px] font-sans uppercase tracking-widest text-gold-300 block">
              {content.hotelBooking.codeLabel}
            </span>
            <span class="font-mono font-bold text-base sm:text-lg text-gold-100 tracking-wider">
              {content.hotelBooking.code}
            </span>
          </div>

          <a
            href={WEDDING_CONFIG.resortBooking.bookingLink}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 rounded-full bg-gold-500 hover:bg-gold-400 text-emerald-950 font-serif font-bold text-sm tracking-wide shadow-lg transition-all hover:scale-105"
          >
            {content.hotelBooking.bookButton}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

---
import type { I18nContent } from '../data/types';

interface Props {
  content: I18nContent['story'];
}

const { content } = Astro.props;
---

<section id="story" class="py-24 px-4 sm:px-6 lg:px-8 relative z-10">
  <div class="max-w-6xl mx-auto">
    {/* Section Header */}
    <div class="text-center max-w-2xl mx-auto mb-16 gsap-reveal">
      <span class="text-xs font-sans font-bold uppercase tracking-widest text-gold-700 mb-2 block">
        {content.eyebrow}
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-emerald-950">
        {content.title}
      </h2>
      <p className="text-stone-600 mt-3 font-serif text-sm sm:text-base">
        {content.subtitle}
      </p>
      <div class="w-16 h-0.5 bg-gold-400 mx-auto mt-4" />
    </div>

    {/* Alternating Story Milestones */}
    <div class="relative space-y-16 sm:space-y-24 before:hidden md:before:block before:absolute before:left-1/2 before:top-4 before:bottom-4 before:w-0.5 before:-translate-x-1/2 before:bg-gradient-to-b before:from-gold-300 before:via-gold-400 before:to-emerald-900/20">
      {content.milestones.map((item, idx) => {
        const isEven = idx % 2 === 0;
        return (
          <div class={`relative flex flex-col md:flex-row items-center gap-8 md:gap-16 gsap-reveal ${isEven ? '' : 'md:flex-row-reverse'}`}>
            {/* Center Timeline Node (Desktop) */}
            <div class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white border-2 border-gold-400 items-center justify-center font-sans font-bold text-xs text-emerald-950 shadow-lg z-10">
              {idx + 1}
            </div>

            {/* Image Box */}
            <div class="w-full md:w-1/2">
              <div class="relative rounded-3xl overflow-hidden shadow-xl border border-gold-200 aspect-4/3 group">
                <img
                  src={item.image}
                  alt={item.title}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
                <div class="absolute top-4 left-4 px-3.5 py-1 rounded-full bg-black/50 backdrop-blur-md border border-white/20 text-gold-200 text-xs font-semibold font-sans">
                  {item.year}
                </div>
              </div>
            </div>

            {/* Text Content */}
            <div class={`w-full md:w-1/2 text-left ${isEven ? 'md:pl-4' : 'md:pr-4'}`}>
              <div class="inline-flex items-center gap-1.5 text-xs font-sans font-bold uppercase tracking-wider text-gold-700 mb-1">
                <span>📍 {item.location}</span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-serif font-bold text-emerald-950 mb-3">
                {item.title}
              </h3>
              <p class="font-serif text-stone-700 text-sm sm:text-base leading-relaxed">
                {item.description}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

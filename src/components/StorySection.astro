---
import type { I18nContent } from '../data/types';

interface Props {
  content: I18nContent['story'];
}

const { content } = Astro.props;
---

<section id="story" class="py-24 px-4 sm:px-6 lg:px-8 relative z-10">
  <div class="max-w-6xl mx-auto">
    {/* Section Header */}
    <div class="text-center max-w-2xl mx-auto mb-16 gsap-reveal">
      <span class="text-xs font-sans font-bold uppercase tracking-widest text-gold-700 mb-2 block">
        {content.eyebrow}
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-emerald-950">
        {content.title}
      </h2>
      <p className="text-stone-600 mt-3 font-serif text-sm sm:text-base">
        {content.subtitle}
      </p>
      <div class="w-16 h-0.5 bg-gold-400 mx-auto mt-4" />
    </div>

    {/* Zigzag timeline: photo + date on one side, text on the other, dot on the centre line */}
    <ol class="relative mx-auto max-w-3xl space-y-12 sm:space-y-16 before:absolute before:inset-y-0 before:left-1/2 before:w-px before:-translate-x-1/2 before:bg-gold-300/60">
      {content.milestones.map((item, idx) => {
        const photoLeft = idx % 2 === 0;
        return (
          <li class="relative grid grid-cols-[1fr_auto_1fr] items-center gap-x-5 sm:gap-x-12 gsap-reveal">
            <div class={`row-start-1 flex flex-col items-center ${photoLeft ? 'col-start-1' : 'col-start-3'}`}>
              <div class="aspect-square w-full max-w-60 overflow-hidden rounded-lg shadow-md">
                {item.image ? (
                  <img src={item.image} alt={item.title} loading="lazy" class="h-full w-full object-cover" />
                ) : (
                  <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-gold-200/60 to-stone-200 font-serif text-sm text-stone-500">
                    {item.title}
                  </div>
                )}
              </div>
              <time class="mt-3 font-serif text-sm tracking-wider text-stone-500 sm:text-base">{item.date}</time>
            </div>

            <span class="col-start-2 row-start-1 h-2.5 w-2.5 rounded-full bg-gold-400 ring-4 ring-ivory" aria-hidden="true"></span>

            <div class={`row-start-1 text-center ${photoLeft ? 'col-start-3' : 'col-start-1'}`}>
              <h3 class="font-serif text-lg text-emerald-950 sm:text-2xl">{item.title}</h3>
              {item.description && (
                <p class="mt-2 font-serif text-sm leading-relaxed text-stone-700 sm:text-base">{item.description}</p>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

---
import type { I18nContent, SupportedLocale } from '../data/types';
import Ornament from './Ornament.astro';

interface Props {
  locale: SupportedLocale;
  content: I18nContent['guide'];
}

const { locale, content } = Astro.props;
---

<!-- Home-page pointer to the separate guest guide page (travel tips + dress code). -->
<section id="guide" class="relative z-10 px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
  <div data-reveal class="mx-auto max-w-2xl text-center">
    <Ornament />
    <p class="mt-8 font-sans text-xs font-semibold tracking-[0.25em] text-accent-700 uppercase">{content.eyebrow}</p>
    <h2 class="mt-3 font-serif text-4xl font-bold text-balance text-ink-950 sm:text-5xl">{content.teaserTitle}</h2>
    <p class="mx-auto mt-5 max-w-xl font-serif text-lg leading-relaxed text-balance text-stone-600 italic">{content.teaserText}</p>
    <a
      href={`/${locale}/guide/`}
      class="group mt-8 inline-flex items-center gap-3 border-b border-accent-600/50 pb-1.5 font-sans text-xs font-medium tracking-[0.3em] text-accent-700 uppercase transition-colors hover:border-accent-700 hover:text-accent-800"
    >
      {content.cta}
      <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </div>
</section>

---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import type { I18nContent } from '../data/types';
import SectionHeader from './SectionHeader.astro';

interface Props {
  content: I18nContent['gallery'];
}

const { content } = Astro.props;

// Every image dropped into src/assets/gallery shows up here, in file-name order.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpg,jpeg,png,webp}', { eager: true });
const photos = await Promise.all(
  Object.keys(files)
    .sort()
    .map(async (path, i) => {
      const src = files[path].default;
      const full = await getImage({ src, width: 1600 });
      return { src, full: full.src, index: i };
    })
);

// Two staggered columns that drift at different speeds while scrolling.
const columns = [photos.filter((_, i) => i % 2 === 0), photos.filter((_, i) => i % 2 === 1)];
const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<section id="gallery" class="section section-tint overflow-x-clip">
  <div class="mx-auto max-w-3xl">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} />

    <div data-gallery class="grid grid-cols-2 items-start gap-3 sm:gap-6">
      {columns.map((column, c) => (
        <div data-gallery-column={c} class={`flex flex-col gap-3 sm:gap-6 ${c === 1 ? 'pt-16 sm:pt-28' : ''}`}>
          {column.map((photo) => (
            <figure data-gallery-item class="group">
              <button
                type="button"
                data-gallery-open={photo.index}
                data-full={photo.full}
                class="relative block w-full cursor-zoom-in overflow-hidden rounded-sm bg-gold-100"
                aria-label={`${content.title} ${pad(photo.index)}`}
              >
                <Image
                  src={photo.src}
                  alt=""
                  widths={[400, 700]}
                  sizes="(min-width: 768px) 360px, 50vw"
                  class="block h-auto w-full transition-transform duration-[1.2s] ease-out group-hover:scale-[1.04]"
                />
                <span
                  class="pointer-events-none absolute inset-2 border border-white/0 transition-colors duration-500 group-hover:border-white/70 sm:inset-3"
                  aria-hidden="true"
                ></span>
              </button>
              <figcaption class="mt-2 flex items-center gap-2 font-serif text-xs tracking-[0.3em] text-gold-700">
                <span class="h-px w-4 bg-gold-400 transition-all duration-500 group-hover:w-8"></span>
                {pad(photo.index)}
              </figcaption>
            </figure>
          ))}
        </div>
      ))}
    </div>
  </div>

  <dialog
    data-lightbox
    tabindex="-1"
    class="m-0 h-dvh max-h-none w-screen max-w-none touch-none overscroll-contain bg-stone-800 outline-none p-0 text-ivory backdrop:bg-transparent"
  >
    <div class="relative flex h-full w-full items-center justify-center select-none">
      <img data-lightbox-img alt="" class="max-h-[86dvh] max-w-[94vw] object-contain shadow-2xl" draggable="false" />

      <button type="button" data-lightbox-close class="absolute top-4 right-4 p-3 text-ivory/80 transition-colors hover:text-ivory" aria-label="Close">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      <button type="button" data-lightbox-prev class="absolute left-2 rounded-full bg-black/30 p-2.5 text-ivory/90 backdrop-blur-sm transition-colors hover:bg-black/50 hover:text-ivory sm:left-4" aria-label="Previous">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button type="button" data-lightbox-next class="absolute right-2 rounded-full bg-black/30 p-2.5 text-ivory/90 backdrop-blur-sm transition-colors hover:bg-black/50 hover:text-ivory sm:right-4" aria-label="Next">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
      <p data-lightbox-counter class="absolute bottom-5 left-1/2 -translate-x-1/2 font-serif text-sm tracking-[0.4em] text-gold-300"></p>
    </div>
  </dialog>
</section>

<style>
  /* Shared-element morph between thumbnail and lightbox photo (View Transitions API). */
  :global(::view-transition-group(gallery-photo)) {
    animation-duration: 0.5s;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }
  dialog[data-lightbox][open] {
    animation: lightbox-fade 0.35s ease-out;
  }
  @keyframes lightbox-fade {
    from { background-color: transparent; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');

  if (gallery && dialog) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // --- Scroll motion: soft reveal per photo + columns drifting at different speeds.
    if (!reduceMotion) {
      // One scrubbed timeline drives both columns in opposite directions.
      gsap
        .timeline({ scrollTrigger: { trigger: gallery, start: 'top bottom', end: 'bottom top', scrub: true } })
        .fromTo('[data-gallery-column="0"]', { y: 0 }, { y: 20, ease: 'none' }, 0)
        .fromTo('[data-gallery-column="1"]', { y: 0 }, { y: -60, ease: 'none' }, 0);

      gallery.querySelectorAll<HTMLElement>('[data-gallery-item]').forEach((item) => {
        const button = item.querySelector('button');
        const img = item.querySelector('img');
        const tl = gsap.timeline({ scrollTrigger: { trigger: item, start: 'top 88%', toggleActions: 'play none none none' } });
        // Soft unveil: the frame opens slightly from all sides while the photo settles and fades in.
        tl.fromTo(
          button,
          { autoAlpha: 0, y: 16, clipPath: 'inset(4% 4% 4% 4%)' },
          { autoAlpha: 1, y: 0, clipPath: 'inset(0% 0% 0% 0%)', duration: 1.4, ease: 'power2.out' }
        )
          .from(img, { scale: 1.06, duration: 1.8, ease: 'power2.out' }, '<')
          .from(item.querySelector('figcaption'), { autoAlpha: 0, duration: 0.8, ease: 'power1.out' }, '-=0.9');
      });
    }

    // --- Lightbox
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-open]')].sort(
      (a, b) => Number(a.dataset.galleryOpen) - Number(b.dataset.galleryOpen)
    );
    const lightboxImg = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lightbox-counter]')!;
    let current = 0;

    const thumbImg = (i: number) => thumbs[i].querySelector('img')!;
    const transition = (update: () => void) => {
      if (reduceMotion || !document.startViewTransition) return update();
      return document.startViewTransition(update);
    };
    const show = (i: number) => {
      current = (i + thumbs.length) % thumbs.length;
      lightboxImg.src = thumbs[current].dataset.full!;
      counter.textContent = `${current + 1} / ${thumbs.length}`;
    };

    const open = (i: number) => {
      const thumb = thumbImg(i);
      thumb.style.viewTransitionName = 'gallery-photo';
      transition(async () => {
        thumb.style.viewTransitionName = '';
        lightboxImg.style.viewTransitionName = 'gallery-photo';
        show(i);
        dialog.showModal();
        dialog.focus(); // keep focus off the close button so no focus ring flashes on open
        // Wait for the full-size photo so the morph lands on the real image, not an empty box.
        await lightboxImg.decode().catch(() => {});
      });
    };

    const close = () => {
      const thumb = thumbImg(current);
      // Bring the thumbnail into view so the photo can morph back into its place.
      thumb.scrollIntoView({ block: 'nearest' });
      transition(() => {
        lightboxImg.style.viewTransitionName = '';
        thumb.style.viewTransitionName = 'gallery-photo';
        dialog.close();
      })?.finished.finally(() => (thumb.style.viewTransitionName = ''));
      if (reduceMotion || !document.startViewTransition) thumb.style.viewTransitionName = '';
    };

    thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => open(i)));
    dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', close);
    dialog.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(current + 1));

    // Esc: run our animated close instead of the native instant one.
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    // Click on the dark backdrop (not the photo or controls) closes.
    dialog.addEventListener('click', (e) => {
      if (swiped) return;
      if (e.target === dialog || e.target === dialog.firstElementChild) close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // Swipe left/right to browse.
    let startX: number | null = null;
    let swiped = false;
    dialog.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      swiped = false;
    });
    dialog.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 50) {
        swiped = true; // keep the click that follows from closing the lightbox
        show(current + (dx < 0 ? 1 : -1));
      }
    });

    // No zooming inside the lightbox (iOS ignores touch-action for pinch, so block gestures too).
    const blockZoom = (e: Event) => dialog.open && e.preventDefault();
    document.addEventListener('gesturestart', blockZoom);
    dialog.addEventListener('touchmove', (e) => e.touches.length > 1 && e.preventDefault(), { passive: false });
    dialog.addEventListener('dblclick', (e) => e.preventDefault());
  }
</script>

---
import type { I18nContent } from '../data/types';
import { DressCodePalette } from './react/DressCodePalette';

interface Props {
  content: I18nContent['dressCode'];
}

const { content } = Astro.props;
---

<section id="dress-code" class="py-24 px-4 sm:px-6 lg:px-8 relative z-10 bg-gold-50/40">
  <div class="max-w-6xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16 gsap-reveal">
      <span class="text-xs font-sans font-bold uppercase tracking-widest text-gold-700 mb-2 block">
        {content.eyebrow}
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-emerald-950">
        {content.title}
      </h2>
      <p class="text-stone-600 mt-2 font-serif text-sm sm:text-base">
        {content.subtitle}
      </p>
      <div class="w-16 h-0.5 bg-gold-400 mx-auto mt-4" />
    </div>

    {/* Attire Guidance Card */}
    <div class="max-w-3xl mx-auto mb-14 text-center p-8 rounded-3xl bg-white border border-gold-200 shadow-lg gsap-reveal">
      <span class="text-3xl mb-2 block">👔 👗</span>
      <h3 class="text-2xl font-serif font-bold text-emerald-950 mb-3">
        {content.attireTitle}
      </h3>
      <p class="font-serif text-stone-700 text-sm sm:text-base leading-relaxed">
        {content.attireDesc}
      </p>
    </div>

    {/* Color Palette and Notes */}
    <div class="gsap-reveal">
      <DressCodePalette content={content} client:visible />
    </div>
  </div>
</section>

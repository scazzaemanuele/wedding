---
import type { I18nContent } from '../data/types';
import SectionHeader from './SectionHeader.astro';
import Ornament from './Ornament.astro';

interface Props {
  content: I18nContent['dressCode'];
}

const { content } = Astro.props;
---

<section id="dress-code" class="section section-tint">
  <div class="mx-auto max-w-6xl">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} subtitle={content.subtitle} />

    <p data-reveal class="mx-auto max-w-2xl text-center font-serif text-base leading-relaxed text-stone-700 sm:text-lg">
      {content.intro}
    </p>

    <div class="mx-auto mt-12 grid max-w-3xl gap-10 sm:grid-cols-2 sm:gap-0 sm:divide-x sm:divide-accent-200">
      {content.groups.map((group) => (
        <div data-reveal class="sm:px-10">
          <h3 class="text-center font-serif text-2xl font-bold text-ink-950 sm:text-left">{group.title}</h3>
          <div class="mx-auto mt-3 h-px w-10 bg-accent-400 sm:mx-0"></div>
          <ul class="mt-5 space-y-3">
            {group.items.map((item) => (
              <li class="flex gap-3 font-serif text-base leading-relaxed text-stone-700">
                <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rotate-45 bg-accent-500" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div data-reveal class="mx-auto mt-16 max-w-xl text-center">
      <Ornament />
      <p class="mt-6 font-script text-3xl leading-snug text-accent-700 sm:text-4xl">{content.closing}</p>
    </div>
  </div>
</section>

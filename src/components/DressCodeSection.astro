---
import type { I18nContent } from '../data/types';
import { DressCodePalette } from './react/DressCodePalette';
import SectionHeader from './SectionHeader.astro';

interface Props {
  content: I18nContent['dressCode'];
}

const { content } = Astro.props;
---

<section id="dress-code" class="section section-tint">
  <div class="max-w-6xl mx-auto">
    <SectionHeader eyebrow={content.eyebrow} title={content.title} subtitle={content.subtitle} />

    {/* Attire Guidance Card */}
    <div data-reveal class="max-w-3xl mx-auto mb-14 text-center p-8 rounded-3xl bg-white border border-gold-200 shadow-lg">
      <span class="text-3xl mb-2 block">👔 👗</span>
      <h3 class="text-2xl font-serif font-bold text-emerald-950 mb-3">
        {content.attireTitle}
      </h3>
      <p class="font-serif text-stone-700 text-sm sm:text-base leading-relaxed">
        {content.attireDesc}
      </p>
    </div>

    {/* Color Palette and Notes */}
    <div data-reveal>
      <DressCodePalette content={content} client:visible />
    </div>
  </div>
</section>
